# ==============================================================================
# Black Sheep Ventures - Collective Intelligence & Simulation Engine
# Environment Configuration Template
# ==============================================================================

# LLM API Configuration (OpenAI Compatible Endpoint)
# Compatible with Google Gemini (via OpenAI-compat endpoint), DeepSeek, OpenAI, Groq, Ollama
LLM_API_KEY=your_llm_api_key_here
LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
LLM_MODEL_NAME=gemini-3.5-flash-lite

# Optional Boost LLM (faster model for bulk agent profile generation or high-speed reasoning)
# LLM_BOOST_API_KEY=your_boost_api_key_here
# LLM_BOOST_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
# LLM_BOOST_MODEL_NAME=gemini-3.5-flash-lite

# Zep Cloud Temporal Graph Memory (https://app.getzep.com/)
ZEP_API_KEY=your_zep_api_key_here

# Server Configuration
FLASK_HOST=0.0.0.0
FLASK_PORT=5001
DEBUG=false
